# Server-side only. Never expose to the browser.
QLOO_API_KEY=

# Shared state (optional). Production uses an Upstash Redis for the daily Qloo quota, rate limits and cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Outside a hosted deployment Redis credentials are IGNORED unless this names an isolated keyspace
# (3-41 chars: a-z, 0-9, "-"). Never run tests, CI or local servers against production counters.
TERRITORY_REDIS_NAMESPACE=
# Set to 1 in test and CI environments: blocks the production keyspace even if hosting looks detected.
TERRITORY_TEST=
